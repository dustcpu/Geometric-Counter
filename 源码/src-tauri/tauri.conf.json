{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "geometric-ocean",
  "version": "0.1.2",
  "identifier": "app.geometricocean.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "ocean",
        "title": "几何任务栏小插件",
        "url": "shell.html",
        "width": 1212,
        "height": 48,
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=CalculateNativeWinOcclusion --disable-background-timer-throttling"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "内测版",
    "shortDescription": "任务栏左侧的一片小海：打字时几何体从水里浮出",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
